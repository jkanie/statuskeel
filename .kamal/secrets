# Secrets for Kamal, read from the environment of the machine you deploy from.
# Never write a raw secret in this file: it is committed to git.
# Export them first, for example from a password manager:
#   export KAMAL_REGISTRY_PASSWORD=...   # registry access token
#   export SECRET_KEY_BASE=...           # bin/rails secret
#   export RAILS_INBOUND_EMAIL_PASSWORD=...   # shared with your mail server's relay
#   export SMTP_USERNAME=... SMTP_PASSWORD=...

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
SECRET_KEY_BASE=$SECRET_KEY_BASE
RAILS_INBOUND_EMAIL_PASSWORD=$RAILS_INBOUND_EMAIL_PASSWORD
SMTP_USERNAME=$SMTP_USERNAME
SMTP_PASSWORD=$SMTP_PASSWORD
