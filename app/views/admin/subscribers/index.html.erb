<% content_for :title, "Subscribers" %>
<h1>Subscribers</h1>
<p class="muted"><%= link_to "#{Subscriber.confirmed.count} confirmed", admin_subscribers_path(state: "confirmed", q: @query.presence) %>, <%= link_to "#{Subscriber.unconfirmed.count} waiting for confirmation", admin_subscribers_path(state: "waiting", q: @query.presence) %>. Unconfirmed addresses are deleted after 3 days.</p>

<%= form_with url: admin_subscribers_path, method: :get, class: "search" do |form| %>
  <%= form.label :q, "Find an address" %>
  <%= form.search_field :q, value: @query %>
  <%= form.hidden_field :state, value: @state if @state %>
  <%= form.submit "Find", name: nil %>
<% end %>
<% if @query.present? || @state %>
  <p class="muted"><%= pluralize(@subscribers.size, "address") %><%= " #{@state == "confirmed" ? "confirmed" : "waiting"}" if @state %><%= %( holding "#{@query}") if @query.present? %>. <%= link_to "Show all", admin_subscribers_path %></p>
<% end %>

<table class="table">
  <thead><tr><th>E-mail address</th><th>Confirmed (UTC)</th><th></th></tr></thead>
  <tbody>
    <% @subscribers.each do |subscriber| %>
      <tr id="<%= dom_id(subscriber) %>">
        <td><%= subscriber.email_address %></td>
        <td><%= subscriber.confirmed_at&.utc&.to_fs(:db) || "not yet" %></td>
        <td><%= button_to "Delete", admin_subscriber_path(subscriber), method: :delete, class: "danger" %></td>
      </tr>
    <% end %>
  </tbody>
</table>
