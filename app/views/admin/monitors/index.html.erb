<% content_for :title, "Monitors" %>
<div class="page-head">
  <h1>Monitors</h1>
  <div class="actions">
    <%= button_to "Check all now", check_all_admin_monitors_path if UptimeMonitor.active.exists? %>
    <%= link_to "New monitor", new_admin_monitor_path, class: "button" %>
  </div>
</div>

<% if @counts.values.sum.positive? %>
  <p class="muted"><%= safe_join(Admin::MonitorsController::STATES.map { |state| link_to("#{@counts.fetch(state, 0)} #{state}", admin_monitors_path(state:, q: @query.presence)) }, ", ") %>.<%= " Showing only the #{@state} ones. " if @state %><%= link_to "Show all", admin_monitors_path if @state || @query.present? %></p>

  <%= form_with url: admin_monitors_path, method: :get, class: "search" do |form| %>
    <%= form.label :q, "Find a monitor by name or URL" %>
    <%= form.search_field :q, value: @query %>
    <%= form.hidden_field :state, value: @state if @state %>
    <%= form.submit "Find", name: nil %>
  <% end %>
<% end %>

<% if @monitors.any? %>
  <table class="table">
    <thead>
      <tr><th>Name</th><th>URL</th><th>State</th><th>Every</th><th>Last check</th><th>Badge</th></tr>
    </thead>
    <tbody>
      <% @monitors.each do |monitor| %>
        <tr id="<%= dom_id(monitor) %>">
          <td><%= link_to monitor.name, admin_monitor_path(monitor) %><%= " (paused)" unless monitor.active? %></td>
          <td class="wrap"><%= monitor.url %></td>
          <td><span class="state-<%= monitor.status %>"><%= monitor.status %></span></td>
          <td><%= monitor.interval_seconds %> s</td>
          <td><%= monitor.last_checked_at ? "#{time_ago_in_words(monitor.last_checked_at)} ago" : "never" %></td>
          <td><%= link_to "SVG", badge_path(monitor, format: :svg) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% elsif @query.present? %>
  <p class="muted">No<%= " #{@state}" if @state %> monitor's name or URL holds "<%= @query %>".</p>
<% elsif @state %>
  <p class="muted">No <%= @state %> monitors.</p>
<% else %>
  <p class="muted">No monitors yet.</p>
<% end %>
