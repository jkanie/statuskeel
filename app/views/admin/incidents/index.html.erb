<% content_for :title, "Incidents" %>
<div class="page-head">
  <h1>Incidents</h1>
  <%= link_to "New incident", new_admin_incident_path, class: "button" %>
</div>

<p class="muted"><%= link_to "#{Incident.unresolved.count} unresolved", admin_incidents_path(state: "unresolved", monitor: @monitor&.id, impact: @impact, q: @query.presence) %>, <%= link_to "#{Incident.resolved.count} resolved", admin_incidents_path(state: "resolved", monitor: @monitor&.id, impact: @impact, q: @query.presence) %>.<%= " Showing only the #{@state} ones. " if @state %><%= " Showing only the incidents of #{@monitor.name}. " if @monitor %><%= " Showing only the #{@impact} impact ones. " if @impact %><%= link_to "Show all", admin_incidents_path if @state || @monitor || @impact || @query.present? %></p>

<%= form_with url: admin_incidents_path, method: :get, class: "search" do |form| %>
  <%= form.label :q, "Find an incident by title" %>
  <%= form.search_field :q, value: @query %>
  <%= form.hidden_field :state, value: @state if @state %>
  <%= form.hidden_field :monitor, value: @monitor.id if @monitor %>
  <%= form.hidden_field :impact, value: @impact if @impact %>
  <%= form.submit "Find", name: nil %>
<% end %>

<% if @incidents.any? %>
  <table class="table">
    <thead><tr><th>Title</th><th>Status</th><th>Impact</th><th>Monitor</th><th>Started (UTC)</th></tr></thead>
    <tbody>
      <% @incidents.each do |incident| %>
        <tr id="<%= dom_id(incident) %>">
          <td><%= link_to incident.title, admin_incident_path(incident) %><%= " (automatic)" if incident.automatic? %></td>
          <td><%= incident.status.humanize %></td>
          <td><%= link_to incident.impact.humanize, admin_incidents_path(impact: incident.impact, state: @state, monitor: @monitor&.id, q: @query.presence) %></td>
          <td><%= link_to incident.uptime_monitor.name, admin_incidents_path(monitor: incident.uptime_monitor.id, state: @state, q: @query.presence) if incident.uptime_monitor %></td>
          <td><%= incident.started_at.utc.to_fs(:db) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="muted">No <%= "#{@state} " if @state %><%= "#{@impact} impact " if @impact %>incidents<%= " of #{@monitor.name}" if @monitor %><%= " with \"#{@query}\" in the title" if @query.present? %>.</p>
<% end %>
