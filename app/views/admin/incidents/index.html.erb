<% content_for :title, "Incidents" %>
<div class="page-head">
  <h1>Incidents</h1>
  <%= link_to "New incident", new_admin_incident_path, class: "button" %>
</div>

<p class="muted"><%= link_to "#{Incident.unresolved.count} unresolved", admin_incidents_path(state: "unresolved") %>, <%= link_to "#{Incident.resolved.count} resolved", admin_incidents_path(state: "resolved") %>.<%= " Showing only the #{@state} ones. " if @state %><%= link_to "Show all", admin_incidents_path if @state %></p>

<% if @incidents.any? %>
  <table class="table">
    <thead><tr><th>Title</th><th>Status</th><th>Impact</th><th>Monitor</th><th>Started (UTC)</th></tr></thead>
    <tbody>
      <% @incidents.each do |incident| %>
        <tr id="<%= dom_id(incident) %>">
          <td><%= link_to incident.title, admin_incident_path(incident) %><%= " (automatic)" if incident.automatic? %></td>
          <td><%= incident.status.humanize %></td>
          <td><%= incident.impact.humanize %></td>
          <td><%= incident.uptime_monitor&.name %></td>
          <td><%= incident.started_at.utc.to_fs(:db) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="muted"><%= @state ? "No #{@state} incidents." : "No incidents." %></p>
<% end %>
